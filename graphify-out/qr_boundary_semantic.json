    {
      "id": "qr_surface_formula",
      "label": "Surface precipitation uses source-associated accumulated fall rates",
      "file_type": "code",
      "source_file": "libtorch/src/sedimentation.cpp",
      "source_location": "L302-L326",
      "_origin": "semantic",
      "total_formula": "max(((fall_qr+fall_qs)+fall_qg)+fall_qi,0)*DELZ/DENR*dtcld*1000",
      "snow_ice_formula": "max(fall_qs+fall_qi,0)*DELZ/DENR*dtcld*1000",
      "graupel_formula": "max(fall_qg,0)*DELZ/DENR*dtcld*1000",
      "qr_only": "Reconstructed from fall_qr for accounting; not a separately returned ABI diagnostic."
    },
