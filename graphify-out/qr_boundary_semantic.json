      "outflow": "dqr_k=min(falk_qr_k*dtcld/DEND_safe,QR_before)",
      "arrival": "dqr_above=min(falk_qr_prev*DELZ_above/DELZ_safe*dtcld/DEND_safe,QR_above_post_update)",
      "state_update": "QR_after=max(QR_before-dqr_k+dqr_above,0)",
      "falk_carry": "The upper cell's stored entry-state falk is reused; it is not recomputed from the depleted upper reservoir."
