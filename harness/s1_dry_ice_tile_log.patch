+          CALL GET_ENVIRONMENT_VARIABLE(TRIM(THREAD_VAR(V)), THREADS, &
+                                        LENGTH=ENV_LENGTH, STATUS=ENV_STATUS)
+          IF (ENV_STATUS /= 0 .OR. ENV_LENGTH /= 1 .OR. THREADS(1:1) /= '1') &
+            CALL wrf_error_fatal('S1 tile log requires one thread')
+        END DO
+        S1_TILE_CALL = S1_TILE_CALL + 1
+        WRITE(*,'(A,9(1X,I0))') 'S1_TILE_CALL', S1_TILE_CALL, ITS, ITE, &
+                               JTS, JTE, IM, JM, ITIMESTEP, 19748
+      ELSE IF ((ENV_STATUS == 1 .AND. ENV_LENGTH == 0) .OR. &
+               (ENV_STATUS == 0 .AND. ENV_LENGTH == 1 .AND. &
+                REQUEST(1:1) == '0')) THEN
+        IF (.NOT. (FILE_STATUS == 1 .AND. FILE_LENGTH == 0 .AND. &
+                   B_STATUS == 1 .AND. B_LENGTH == 0)) &
+          CALL wrf_error_fatal('S1 trace vars require tile log')
+      ELSE
+        CALL wrf_error_fatal('S1 tile log must be unset, 0 or 1')
+      END IF
+    END BLOCK
