+      INTEGER :: ENV_STATUS, ENV_LENGTH, V, FILE_STATUS, FILE_LENGTH, B_STATUS, B_LENGTH
+      REQUEST = ''
+      CALL GET_ENVIRONMENT_VARIABLE('KDM6_S1_TILE_LOG', REQUEST, &
+                                    LENGTH=ENV_LENGTH, STATUS=ENV_STATUS)
+      TRACE_FILE = ''
+      TRACE_B = ''
+      CALL GET_ENVIRONMENT_VARIABLE('KDM6_S1_TRACE_FILE', TRACE_FILE, &
+                                    LENGTH=FILE_LENGTH, STATUS=FILE_STATUS)
+      CALL GET_ENVIRONMENT_VARIABLE('KDM6_S1_TRACE_B', TRACE_B, &
+                                    LENGTH=B_LENGTH, STATUS=B_STATUS)
+      IF (ENV_STATUS == 0 .AND. ENV_LENGTH == 1 .AND. REQUEST(1:1) == '1') THEN
+        IF (FILE_STATUS /= 0 .OR. FILE_LENGTH <= 0 .OR. &
+            FILE_LENGTH > LEN(TRACE_FILE) .OR. TRACE_FILE(1:1) /= '/' .OR. &
+            B_STATUS /= 0 .OR. B_LENGTH /= 5 .OR. TRACE_B(1:5) /= '19748' .OR. &
