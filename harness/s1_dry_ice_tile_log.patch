+    ! S1 diagnostic: identify each host tile call without changing C++ inputs.
+    BLOCK
+      CHARACTER(LEN=8) :: REQUEST, THREADS
+      CHARACTER(LEN=16) :: TRACE_B
+      CHARACTER(LEN=512) :: TRACE_FILE
+      CHARACTER(LEN=16), PARAMETER :: THREAD_VAR(3) = [CHARACTER(LEN=16) :: &
