diff --git a/libtorch/src/batch5_capture.cpp b/libtorch/src/batch5_capture.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..dc01d247003bd7ad5173801c59fab3f45b3a8de2
--- /dev/null
+++ b/libtorch/src/batch5_capture.cpp
@@ -0,0 +1,129 @@
+#include "kdm6/batch5_capture.h"
+#ifdef KDM6_BATCH5_RESEARCH_CAPTURE
+#include <map>
+#include <mutex>
+#include <memory>
+#include <atomic>
+#include <stdexcept>
+#include <tuple>
+#include <utility>
+
+namespace kdm6::batch5 {
+namespace {
+struct Context {
+    bool on = false;
+    bool entered = false;
+    bool outer_set = false;
+    bool is_top_first = false;
+    std::string input_id, mode, family = "runtime", source_site;
+    std::uint64_t observed_one_steps = 0;
+    std::uint64_t runtime_call = 0, one_step_call = 0, outer_loop = 0, substep_n = 0;
+    std::vector<Record> data;
+    InputLeaves leaves;
+    const void* handle = nullptr;
+    std::uint64_t token = 0;
+    std::shared_ptr<std::atomic<bool>> valid;
+    std::map<std::tuple<std::uint64_t,std::uint64_t,std::string,std::uint64_t,std::string,std::string,std::string,std::string,std::int64_t,std::int64_t>,std::uint64_t> ordinals;
+};
+thread_local Context ctx;
+thread_local std::uint64_t runtime_sequence = 0;
+std::atomic<std::uint64_t> token_sequence{0};
+std::mutex binding_mutex;
+std::map<const void*, std::shared_ptr<std::atomic<bool>>> bindings;
+void add(const char* stage, const char* field, const char* scope,
+         std::int64_t b, std::int64_t k, std::int64_t level, std::int64_t B, std::int64_t K, const torch::Tensor& t) {
+    if (!ctx.on) return;
+    if (!t.defined() || ctx.data.size() >= 2000000) throw std::runtime_error("batch5 capture undefined tensor or record limit");
+    const std::string kind = t.scalar_type() == torch::kBool ? "mask" : "value";
+    auto key=std::make_tuple(ctx.one_step_call,ctx.outer_loop,ctx.family,ctx.substep_n,std::string(scope),std::string(stage),std::string(field),kind,b,k);
+    auto ordinal=ctx.ordinals[key]++;
+    ctx.data.push_back(Record{ctx.input_id,ctx.mode,ctx.family,scope,stage,field,
+        kind,"none","none","none","none",ctx.runtime_call,ctx.one_step_call,
+        ctx.outer_loop,ctx.substep_n,ordinal,b,k,level,B,K,t});
+}
+}
+void begin(const std::string& input_id,const std::string& mode,std::uint64_t runtime_call) {
+    if (input_id.empty() || input_id.size()>=128 || (mode!="capture_on_value" && mode!="center_joint_graph") || runtime_call==0)
+        throw std::invalid_argument("batch5 capture context invalid");
+    if (ctx.on) throw std::runtime_error("batch5 prior context must be explicitly cleared");
+    ctx=Context{}; ctx.on=true;ctx.input_id=input_id;ctx.mode=mode;ctx.runtime_call=runtime_call;
+}
+void invalidate_handle(const void* handle) {
+    std::lock_guard<std::mutex> lock(binding_mutex);
+    auto it=bindings.find(handle); if (it!=bindings.end()) { it->second->store(false); bindings.erase(it); }
+}
+void clear(){
+    // A stale TLS context may outlive a cross-thread close and address reuse.
+    // Only invalidate the exact generation owned by this context.
+    if (ctx.handle && ctx.valid) {
+        std::lock_guard<std::mutex> lock(binding_mutex);
+        auto it=bindings.find(ctx.handle);
+        ctx.valid->store(false);
+        if (it!=bindings.end() && it->second==ctx.valid) bindings.erase(it);
+    }
+    ctx=Context{};
+}
+void bind_handle(const void* handle) {
+    if (!ctx.on || !ctx.entered || ctx.mode!="center_joint_graph" || !handle || ctx.handle)
+        throw std::runtime_error("batch5 invalid graph binding");
+    auto valid=std::make_shared<std::atomic<bool>>(true);
+    std::lock_guard<std::mutex> lock(binding_mutex);
+    if (!bindings.emplace(handle,valid).second) throw std::runtime_error("batch5 duplicate graph binding");
+    ctx.handle=handle; ctx.valid=valid; ctx.token=++token_sequence;
+    if (ctx.token==0) { valid->store(false); bindings.erase(handle); ctx.handle=nullptr; throw std::runtime_error("batch5 token exhausted"); }
+}
+std::unique_lock<std::mutex> lock_bound_handle(const void* handle, std::uint64_t token) {
+    std::unique_lock<std::mutex> lock(binding_mutex);
+    auto it=bindings.find(handle);
+    if (!ctx.on || !ctx.entered || ctx.mode!="center_joint_graph" || !handle || ctx.handle!=handle || token==0 || ctx.token!=token || !ctx.valid || !ctx.valid->load() || it==bindings.end() || it->second!=ctx.valid)
+        throw std::runtime_error("batch5 stale, foreign or wrong-thread graph binding");
+    return lock;
+}
+
+std::uint64_t binding_token(const void* handle) {
+    auto token=ctx.token;
+    auto lock=lock_bound_handle(handle,token);
+    return token;
+}
+
+bool enabled(){return ctx.on;}
+void enter_runtime(bool value_only){
+    const auto observed=++runtime_sequence;
+    if(ctx.on) {
+        if(ctx.entered || observed!=ctx.runtime_call || value_only!=(ctx.mode=="capture_on_value"))
+            throw std::runtime_error("batch5 actual runtime sequence, lifecycle or mode mismatch");
+        ctx.entered=true;
+    }
+}
+void retain_inputs(const std::vector<torch::Tensor>& state,const std::vector<torch::Tensor>& forcing){if(ctx.on)ctx.leaves={state,forcing};}
+const InputLeaves& inputs(){return ctx.leaves;}
+const std::vector<Record>& records(){return ctx.data;}
+void outer(std::uint64_t i){if(ctx.on){if(!ctx.entered)throw std::runtime_error("batch5 runtime not entered");ctx.outer_set=true;ctx.outer_loop=i;ctx.one_step_call=0;ctx.family="outer";ctx.substep_n=0;}}
+void micro_step(){if(ctx.on){if(!ctx.entered || !ctx.outer_set)throw std::runtime_error("batch5 missing runtime/outer context");ctx.is_top_first=false;ctx.family="microphysics";ctx.substep_n=0;ctx.one_step_call=++ctx.observed_one_steps;}}
+void phase(const char* family,std::uint64_t n){if(ctx.on){ctx.family=family;ctx.substep_n=n;}}
+void orientation(bool top){if(ctx.on)ctx.is_top_first=top;}
+bool top_first(){return ctx.is_top_first;}
+void site(const char* name){if(ctx.on)ctx.source_site=name ? name : "";}
+const std::string& site(){return ctx.source_site;}
+void full(const char* stage,const char* field,const torch::Tensor& t,bool top_first){
+    if(!ctx.on)return;
+    if(t.dim()!=2 || t.size(0)!=1 || t.size(1)!=39)
+        throw std::runtime_error("batch5 narrow capture requires rank-2 B=1 K=39");
+    auto B=t.size(0),K=t.size(1);
+    for(std::int64_t b=0;b<B;++b)for(std::int64_t k=0;k<K;++k){
+        auto storage_k=top_first?k:K-1-k;
+        add(stage,field,"layer",b,k,K-k,B,K,t.select(0,b).select(0,storage_k));
+    }
+}
+void column(const char* stage,const char* field,const torch::Tensor& t){
+    if(!ctx.on)return;
+    if(t.dim()!=1 || t.size(0)!=1)throw std::runtime_error("batch5 narrow capture requires B=1 column tensor");
+    for(std::int64_t b=0;b<t.size(0);++b)add(stage,field,"column",b,-1,-1,t.size(0),-1,t.select(0,b));
+}
+void layer(const char* stage,const char* field,const torch::Tensor& t,std::int64_t k,std::int64_t K){
+    if(!ctx.on)return;
+    if(t.dim()!=1 || t.size(0)!=1 || K!=39 || k<0 || k>=K)throw std::runtime_error("batch5 narrow capture requires B=1 K=39 layer tensor");
+    for(std::int64_t b=0;b<t.size(0);++b)add(stage,field,"layer",b,k,K-k,t.size(0),K,t.select(0,b));
+}
+}
+#endif
diff --git a/libtorch/src/batch5_intermediate_ad.cpp b/libtorch/src/batch5_intermediate_ad.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..56d4804543da5d06996b804cde1bec8680a24cd3
--- /dev/null
+++ b/libtorch/src/batch5_intermediate_ad.cpp
@@ -0,0 +1,57 @@
+#include "kdm6/batch5_intermediate_ad.h"
+#ifdef KDM6_BATCH5_RESEARCH_CAPTURE
+#include <torch/csrc/autograd/autograd.h>
+namespace kdm6::batch5 {
+std::vector<IntermediateJvp> intermediate_jvp(
+    const std::vector<torch::Tensor>& scalars,
+    const std::vector<torch::Tensor>& leaves,
+    const std::vector<torch::Tensor>& directions) {
+    TORCH_CHECK(!scalars.empty() && scalars.size() <= 64, "batch5: scalar count must be 1..64");
+    TORCH_CHECK(leaves.size() == 16 && directions.size() == 16, "batch5: 16 leaves and directions required");
+    for (size_t i = 0; i < leaves.size(); ++i) {
+        const auto& x = leaves[i]; const auto& v = directions[i];
+        TORCH_CHECK(x.defined() && x.is_leaf() && x.requires_grad() && x.device().is_cpu() && x.scalar_type() == torch::kFloat64,
+                    "batch5: CPU f64 differentiable leaf required");
+        TORCH_CHECK(v.defined() && v.device() == x.device() && v.scalar_type() == x.scalar_type() && v.sizes() == x.sizes(),
+                    "batch5: direction metadata mismatch");
+    }
+    std::vector<IntermediateJvp> out; out.reserve(scalars.size());
+    for (const auto& y : scalars) {
+        TORCH_CHECK(y.defined() && y.numel() == 1 && y.device().is_cpu() && y.scalar_type() == torch::kFloat64,
+                    "batch5: CPU f64 scalar required");
+        if (!y.requires_grad()) { out.push_back({IntermediateStatus::NO_GRAPH_PATH, torch::zeros_like(y)}); continue; }
+        auto u = torch::zeros_like(y).requires_grad_(true);
+        auto weighted = (y * u).sum();
+        auto grads = torch::autograd::grad({weighted}, leaves, {}, true, true, true);
+        auto inner = torch::zeros({}, y.options()); bool connected = false;
+        for (size_t i = 0; i < grads.size(); ++i) {
+            if (grads[i].defined()) { inner = inner + (grads[i] * directions[i]).sum(); connected = true; }
+        }
+        if (!connected) { out.push_back({IntermediateStatus::UNCONNECTED, torch::zeros_like(y)}); continue; }
+        TORCH_CHECK(inner.requires_grad(), "batch5: connected reverse graph is not differentiable in cotangent");
+        auto tangent = torch::autograd::grad({inner}, {u}, {}, true, false, true);
+        TORCH_CHECK(tangent.size() == 1 && tangent[0].defined(), "batch5: missing scalar tangent");
+        out.push_back({IntermediateStatus::CONNECTED, tangent[0]});
+    }
+    return out;
+}
+IntermediateVjp intermediate_vjp(const torch::Tensor& y,
+    const std::vector<torch::Tensor>& leaves, const torch::Tensor& u) {
+    TORCH_CHECK(leaves.size()==16, "batch5: 16 leaves required");
+    for (const auto& x : leaves) {
+        TORCH_CHECK(x.defined() && x.is_leaf() && x.requires_grad() && x.device().is_cpu() && x.scalar_type()==torch::kFloat64,
+                    "batch5: CPU f64 differentiable leaf required");
+    }
+    TORCH_CHECK(y.defined() && y.numel()==1 && y.device().is_cpu() && y.scalar_type()==torch::kFloat64,
+                "batch5: CPU f64 scalar required");
+    TORCH_CHECK(u.defined() && u.numel()==1 && u.device()==y.device() && u.scalar_type()==y.scalar_type() && u.sizes()==y.sizes(),
+                "batch5: scalar cotangent metadata mismatch");
+    if (!y.requires_grad()) return {IntermediateStatus::NO_GRAPH_PATH, std::vector<torch::Tensor>(16)};
+    auto grads=torch::autograd::grad({y},leaves,{u},true,false,true);
+    bool connected=false;
+    for (const auto& g:grads) if (g.defined()) connected=true;
+    return {connected ? IntermediateStatus::CONNECTED : IntermediateStatus::UNCONNECTED, std::move(grads)};
+}
+
+}
+#endif
