+#include <cassert>
+#include <cstdint>
+int main() {
+    for(const char* mode : {"capture_off_value","capture_on_value","center_joint_graph"}) {
+        assert(kdm6_batch5_begin_c("f32_reject",mode,1)==0);
+        std::array<float,39> in{};in.fill(1.f);std::array<float,39> out{};out.fill(123.f);
+        float land=2.f,rain=456.f,snow=456.f,graupel=456.f;
+        kdm6_handle_t* handle=reinterpret_cast<kdm6_handle_t*>(static_cast<std::uintptr_t>(1));
+        int rc=kdm6_step_c(in.data(),in.data(),in.data(),in.data(),in.data(),in.data(),
+            in.data(),in.data(),in.data(),in.data(),in.data(),in.data(),
+            in.data(),in.data(),in.data(),in.data(),1,39,1,20.,0,1,
+            out.data(),out.data(),out.data(),out.data(),out.data(),out.data(),
+            out.data(),out.data(),out.data(),out.data(),out.data(),out.data(),
+            &handle,&land,10.,10.,&rain,&snow,&graupel,out.data());
+        assert(rc==KDM6_ERR_INVALID_ARG && handle==nullptr);
+        for(float x:out) assert(x==123.f);
+        assert(rain==456.f && snow==456.f && graupel==456.f && kdm6_batch5_count_c()==0);
