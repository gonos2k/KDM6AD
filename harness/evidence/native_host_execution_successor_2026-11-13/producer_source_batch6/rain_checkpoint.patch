+        handle=reinterpret_cast<kdm6_handle_t*>(static_cast<std::uintptr_t>(1));
+        rc=kdm6_step_ad_c(d_in.data(),d_in.data()+468,1,39,1,20.,value_only,d_out.data(),&handle,&land,10.,10.);
