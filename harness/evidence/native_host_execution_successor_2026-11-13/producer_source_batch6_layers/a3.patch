     }
 }
+// Raw declared C++ double; effective tensor-comparison conversion is separate.
+inline void scalar_f64(const char* stage,const char* field,const char* source_hook,double value) {
+    if (!batch5::enabled()) return;
+    using ScalarKey=std::tuple<std::uint64_t,std::uint64_t,std::string,std::uint64_t,std::string,std::string,std::string>;
+    static thread_local std::uint64_t epoch=0;
+    static thread_local std::map<ScalarKey,std::uint64_t> ordinals;
+    auto c=batch5::context_snapshot();
+    if(epoch!=c.epoch){ordinals.clear();epoch=c.epoch;}
+    ScalarKey key{c.one_step_call,c.outer_loop,c.family,c.substep_n,stage,field,source_hook};
+    auto it=ordinals.find(key);const auto ord=it==ordinals.end()?0:it->second;
+    std::uint64_t bits=0; static_assert(sizeof(bits)==sizeof(value),"double size");
+    std::memcpy(&bits,&value,sizeof(bits));
+    control(stage,field,source_hook,Dtype::F64,bits,ord);
+    ordinals[key]=ord+1;
 }
+} // A2_DIAG_HELPER_END
 #endif
