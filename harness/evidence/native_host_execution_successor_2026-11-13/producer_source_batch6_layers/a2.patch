diff --git a/libtorch/include/kdm6/batch6_a2_named_hooks.h b/libtorch/include/kdm6/batch6_a2_named_hooks.h
new file mode 100644
index 0000000000000000000000000000000000000000..7d629887f4e62f673e2d65669dd5fe88e038dee7
--- /dev/null
+++ b/libtorch/include/kdm6/batch6_a2_named_hooks.h
@@ -0,0 +1,28 @@
+#pragma once
+#ifdef KDM6_BATCH5_RESEARCH_CAPTURE
+#include "kdm6/batch5_conditions_v2.h"
+#include <map>
+#include <tuple>
+namespace kdm6::batch5::a2_named {
+// Private source-only prototype. Ordinals follow the v2 identity key and reset
+// on epoch change. Calls remain on the context-owning thread.
+using namespace conditions_v2;
+using Key=std::tuple<std::uint64_t,std::uint64_t,std::string,std::uint64_t,int,std::int64_t,std::string,std::string,std::string,int>;
+inline void record(const char* stage,const char* field,const char* source_hook,Role role,
+                   Scope scope,const torch::Tensor& t,bool top_first) {
+    if (!batch5::enabled()) return;
+    static thread_local std::uint64_t epoch=0;
+    static thread_local std::map<Key,std::uint64_t> ordinals;
+    auto c=batch5::context_snapshot();
+    if(epoch!=c.epoch){ordinals.clear();epoch=c.epoch;}
+    const int count=scope==Scope::LAYER?39:1;
+    for(int i=0;i<count;++i){
+        const auto k=scope==Scope::LAYER?i:-1;
+        Key key{c.one_step_call,c.outer_loop,c.family,c.substep_n,int(scope),k,stage,field,source_hook,int(role)};
+        auto it=ordinals.find(key);const auto ord=it==ordinals.end()?0:it->second;
+        tensor(stage,field,source_hook,role,scope,t,k,top_first,ord);
+        ordinals[key]=ord+1;
+    }
+}
+}
+#endif
