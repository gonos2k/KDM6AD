@@ -0,0 +1,32 @@
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Separate research-only v2 metadata ABI; v1 is unchanged. */
+enum { KDM6_BATCH5_CONDITION_V2_VERSION = 2 };
+enum kdm6_batch5_condition_v2_role { KDM6_V2_CONSUMED_BOOL=1, KDM6_V2_DIAGNOSTIC=2, KDM6_V2_OPERAND=3, KDM6_V2_CONTROL=4, KDM6_V2_NOT_EVALUATED=5 };
+enum kdm6_batch5_condition_v2_dtype { KDM6_V2_BOOL=1, KDM6_V2_F32=2, KDM6_V2_F64=3, KDM6_V2_I64=4, KDM6_V2_NO_DTYPE=5 };
+enum kdm6_batch5_condition_v2_scope { KDM6_V2_LAYER=1, KDM6_V2_COLUMN=2, KDM6_V2_SCALAR=3 };
+enum kdm6_batch5_condition_v2_reason { KDM6_V2_NO_REASON=0, KDM6_V2_GATE_FALSE=1, KDM6_V2_OPTIONAL_ABSENT=2, KDM6_V2_FAMILY_NOT_REACHED=3 };
+struct kdm6_batch5_condition_v2_meta {
+    uint32_t abi_version, struct_size;
+    char input_id[128], mode[32], family[32], stage[64], field[64], source_hook[128];
+    uint64_t context_epoch, runtime_call, one_step_call, outer_loop, substep_n, event_ordinal, causal_index;
+    int64_t b_zero, k_zero, native_level_bottom_first, B, K;
+    uint32_t role, dtype, scope, reason;
+};
+/* Graph mode requires same live handle/token and thread. Value mode requires
+ * NULL/0. Metadata copy uses caller-initialized exact version and size. */
+int kdm6_batch5_condition_v2_count_c(const void*,uint64_t,uint64_t*);
+int kdm6_batch5_condition_v2_meta_c(const void*,uint64_t,uint64_t,struct kdm6_batch5_condition_v2_meta*,size_t);
+/* Raw copy is value-mode only. NOT_EVALUATED has no raw value; its causal
+ * reference is metadata and requires separate truth/coverage verification. */
+int kdm6_batch5_condition_v2_raw_c(const void*,uint64_t,uint64_t,uint64_t*);
+/* Check referenced predicate values only after value-only forward. This does
+ * not validate completeness or physical meaning; graph mode is unsupported. */
+int kdm6_batch5_condition_v2_verify_absences_c(const void*,uint64_t,uint64_t*);
+#ifdef __cplusplus
+}
+#endif
