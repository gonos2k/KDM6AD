+#pragma once
+#ifdef KDM6_BATCH5_RESEARCH_CAPTURE
+#include "kdm6/batch5_capture.h"
+#include <cstdint>
+#include <string>
+#include <vector>
+namespace kdm6::batch5::conditions_v2 {
+enum class Role : std::uint8_t { CONSUMED_BOOL_TENSOR=1, DIAGNOSTIC_COMPARISON=2, OPERAND=3, CONTROL_SCALAR=4, NOT_EVALUATED=5 };
+enum class Dtype : std::uint8_t { BOOL=1, F32=2, F64=3, I64=4, NONE=5 };
+enum class Scope : std::uint8_t { LAYER=1, COLUMN=2, SCALAR=3 };
+enum class Reason : std::uint8_t { NONE=0, GATE_FALSE=1, OPTIONAL_INPUT_ABSENT=2, FAMILY_NOT_REACHED=3 };
+struct Record {
+    ContextSnapshot context;
+    std::string stage, field, source_hook;
+    Role role; Dtype dtype; Scope scope; Reason reason;
+    std::int64_t b_zero, k_zero, native_level_bottom_first, B, K;
+    std::uint64_t event_ordinal, raw_control, causal_index;
+    torch::Tensor tensor;
+};
+constexpr std::uint64_t NO_CAUSE=UINT64_MAX;
+// Caller selects one real source tensor view; no recomputation is implied.
+void tensor(const char* stage,const char* field,const char* source_hook, Role role,
+            Scope scope,const torch::Tensor& source,std::int64_t k_top,bool top_first,
+            std::uint64_t ordinal);
+void control(const char* stage,const char* field,const char* source_hook,Dtype dtype,
+             std::uint64_t raw_bits,std::uint64_t ordinal);
+// Refers to prior same-context consumed predicate; later verifier must prove it
+// is false. Metadata linkage does not itself establish the predicate's truth.
+void absent(const char* stage,const char* field,const char* source_hook, Scope scope,
+            std::int64_t k_top,Reason reason,std::uint64_t causal_index,std::uint64_t ordinal);
+const std::vector<Record>& records();
+void clear();
+}
+#endif
