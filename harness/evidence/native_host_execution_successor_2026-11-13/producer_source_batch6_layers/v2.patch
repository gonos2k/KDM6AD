+        if(!out || size!=sizeof(*out) || out->abi_version!=KDM6_BATCH5_CONDITION_V2_VERSION || out->struct_size!=sizeof(*out))return -1;
+        auto lock=access(h,token);const auto& rows=kdm6::batch5::conditions_v2::records();if(index>=rows.size())return -1;
+        const auto& r=rows[index];kdm6_batch5_condition_v2_meta m{};m.abi_version=KDM6_BATCH5_CONDITION_V2_VERSION;m.struct_size=sizeof(m);
+        if(!copy(m.input_id,r.context.input_id)||!copy(m.mode,r.context.mode)||!copy(m.family,r.context.family)||!copy(m.stage,r.stage)||!copy(m.field,r.field)||!copy(m.source_hook,r.source_hook))return -1;
+        m.context_epoch=r.context.epoch;m.runtime_call=r.context.runtime_call;m.one_step_call=r.context.one_step_call;m.outer_loop=r.context.outer_loop;m.substep_n=r.context.substep_n;m.event_ordinal=r.event_ordinal;m.causal_index=r.causal_index;
+        m.b_zero=r.b_zero;m.k_zero=r.k_zero;m.native_level_bottom_first=r.native_level_bottom_first;m.B=r.B;m.K=r.K;m.role=uint32_t(r.role);m.dtype=uint32_t(r.dtype);m.scope=uint32_t(r.scope);m.reason=uint32_t(r.reason);*out=m;return 0;
+    } catch(...){return -1;}
+}
+extern "C" KDM6_C_API int kdm6_batch5_condition_v2_raw_c(const void* h,std::uint64_t token,std::uint64_t index,std::uint64_t* out){
+    try {
+        if(!out)return -1;auto lock=access(h,token);auto c=kdm6::batch5::context_snapshot();if(c.mode!="capture_on_value")return -1;
+        const auto& rows=kdm6::batch5::conditions_v2::records();if(index>=rows.size())return -1;const auto& r=rows[index];std::uint64_t bits=0;
+        if(r.role==kdm6::batch5::conditions_v2::Role::NOT_EVALUATED)return -1;
+        if(r.role==kdm6::batch5::conditions_v2::Role::CONTROL_SCALAR)bits=r.raw_control;
+        else {const auto& t=r.tensor;if(!t.defined()||!t.device().is_cpu()||t.numel()!=1||!t.is_contiguous())return -1;
+            if(r.dtype==kdm6::batch5::conditions_v2::Dtype::BOOL)bits=*t.data_ptr<bool>()?1:0;
+            else if(r.dtype==kdm6::batch5::conditions_v2::Dtype::F32){std::uint32_t x;std::memcpy(&x,t.data_ptr<float>(),4);bits=x;}
+            else if(r.dtype==kdm6::batch5::conditions_v2::Dtype::F64)std::memcpy(&bits,t.data_ptr<double>(),8);
+            else return -1;}
+        *out=bits;return 0;
+    } catch(...){return -1;}
+}
+extern "C" KDM6_C_API int kdm6_batch5_condition_v2_verify_absences_c(const void* h,std::uint64_t token,std::uint64_t* out){
+    try {
+        if(!out)return -1;auto lock=access(h,token);auto c=kdm6::batch5::context_snapshot();if(c.mode!="capture_on_value")return -1;
+        const auto& rows=kdm6::batch5::conditions_v2::records();std::uint64_t count=0;
+        for(const auto& r:rows) if(r.role==kdm6::batch5::conditions_v2::Role::NOT_EVALUATED){
+            if(r.causal_index>=rows.size())return -1;const auto& t=rows[r.causal_index].tensor;
+            if(!t.defined() || !t.device().is_cpu() || t.scalar_type()!=torch::kBool || t.numel()!=1 || !t.is_contiguous() || *t.data_ptr<bool>())return -1;
+            ++count;
+        }
+        *out=count;return 0;
+    } catch(...){return -1;}
+}
+
+#endif
