+    if(c.mode=="center_joint_graph") return kdm6::batch5::lock_bound_handle(h,token);
+    if(c.mode!="capture_on_value" || h || token) throw std::runtime_error("v2 value context identity");
+    return {};
+}
+}
+extern "C" KDM6_C_API int kdm6_batch5_condition_v2_count_c(const void* h,std::uint64_t token,std::uint64_t* out){
+    try {if(!out)return -1;auto lock=access(h,token);auto n=kdm6::batch5::conditions_v2::records().size();*out=n;return 0;}catch(...){return -1;}
