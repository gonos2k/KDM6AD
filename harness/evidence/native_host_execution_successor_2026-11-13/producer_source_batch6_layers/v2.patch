+thread_local std::uint64_t epoch=0;
+void check_context(const ContextSnapshot& c) {
+    if(epoch && epoch!=c.epoch) throw std::runtime_error("v2 stale context requires clear");
+}
+void append(Record r) {
+    check_context(r.context);
+    if(data.size()>=2000000) throw std::runtime_error("v2 record limit");
+    if(r.stage.empty() || r.field.empty() || r.source_hook.empty() || r.stage.size()>=64 || r.field.size()>=64 || r.source_hook.size()>=128)
+        throw std::runtime_error("v2 invalid record label");
+    Key key{r.context.runtime_call,r.context.one_step_call,r.context.outer_loop,r.context.family,r.context.substep_n,
+            int(r.scope),r.b_zero,r.k_zero,r.B,r.K,r.stage,r.field,r.source_hook,int(r.role)};
+    auto it=ordinals.find(key);auto next=it==ordinals.end()?0:it->second;
+    if(r.event_ordinal!=next) throw std::runtime_error("v2 duplicate or missing event ordinal");
+    data.push_back(std::move(r));
+    try { ordinals[key]=next+1; } catch (...) {data.pop_back();throw;}
+    epoch=data.back().context.epoch;
+}
+Record base(const char* stage,const char* field,const char* hook,Role role,Scope scope,std::uint64_t ord) {
+    if(!stage || !field || !hook) throw std::runtime_error("v2 null label");
+    auto c=context_snapshot();check_context(c);
+    if(c.forward_committed) throw std::runtime_error("v2 forward already committed");
+    return {c,stage,field,hook,role,Dtype::NONE,scope,Reason::NONE,-1,-1,-1,-1,-1,ord,0,NO_CAUSE,{}};
+}
+bool same_context(const Record& a,const Record& b) {
+    const auto& x=a.context; const auto& y=b.context;
+    return x.epoch==y.epoch && x.runtime_call==y.runtime_call && x.one_step_call==y.one_step_call &&
+           x.outer_loop==y.outer_loop && x.family==y.family && x.substep_n==y.substep_n &&
+           a.scope==b.scope && a.b_zero==b.b_zero && a.k_zero==b.k_zero &&
+           a.native_level_bottom_first==b.native_level_bottom_first && a.B==b.B && a.K==b.K && a.event_ordinal==b.event_ordinal;
+}
+}
+void tensor(const char* stage,const char* field,const char* hook,Role role,Scope scope,
+            const torch::Tensor& source,std::int64_t k,bool top_first,std::uint64_t ordinal) {
+    if(role!=Role::CONSUMED_BOOL_TENSOR && role!=Role::DIAGNOSTIC_COMPARISON && role!=Role::OPERAND)
+        throw std::runtime_error("v2 invalid tensor role");
+    if(!source.defined() || !source.device().is_cpu()) throw std::runtime_error("v2 invalid tensor");
+    auto r=base(stage,field,hook,role,scope,ordinal);
+    if(scope==Scope::LAYER) {
+        if(source.dim()!=2 || source.size(0)!=1 || source.size(1)!=39 || k<0 || k>=39) throw std::runtime_error("v2 invalid layer shape");
+        auto storage=top_first?k:38-k;r.b_zero=0;r.k_zero=k;r.native_level_bottom_first=39-k;r.B=1;r.K=39;
+        r.tensor=source.select(0,0).select(0,storage);
+    } else if(scope==Scope::COLUMN) {
+        if(source.dim()!=1 || source.size(0)!=1 || k!=-1) throw std::runtime_error("v2 invalid column shape");
+        r.b_zero=0;r.B=1;r.tensor=source.select(0,0);
+    } else throw std::runtime_error("v2 tensor scalar scope unsupported");
+    if(role==Role::OPERAND) {
+        if(source.scalar_type()==torch::kFloat32) r.dtype=Dtype::F32;
+        else if(source.scalar_type()==torch::kFloat64) r.dtype=Dtype::F64;
+        else throw std::runtime_error("v2 operand dtype");
+    } else {
+        if(source.scalar_type()!=torch::kBool) throw std::runtime_error("v2 predicate dtype");
+        r.dtype=Dtype::BOOL;
+    }
+    append(std::move(r));
+}
+void control(const char* stage,const char* field,const char* hook,Dtype dtype,std::uint64_t bits,std::uint64_t ordinal) {
+    if((dtype==Dtype::F32 && (bits>>32)!=0) || (dtype==Dtype::BOOL && bits>1) ||
+       (dtype!=Dtype::F32 && dtype!=Dtype::F64 && dtype!=Dtype::I64 && dtype!=Dtype::BOOL)) throw std::runtime_error("v2 control dtype/raw");
+    auto r=base(stage,field,hook,Role::CONTROL_SCALAR,Scope::SCALAR,ordinal);r.dtype=dtype;r.raw_control=bits;append(std::move(r));
+}
+void absent(const char* stage,const char* field,const char* hook,Scope scope,std::int64_t k,Reason reason,std::uint64_t cause,std::uint64_t ordinal) {
+    if(reason!=Reason::GATE_FALSE && reason!=Reason::OPTIONAL_INPUT_ABSENT && reason!=Reason::FAMILY_NOT_REACHED) throw std::runtime_error("v2 invalid absence reason");
+    auto r=base(stage,field,hook,Role::NOT_EVALUATED,scope,ordinal);r.reason=reason;r.causal_index=cause;
+    if(scope==Scope::LAYER && k>=0 && k<39){r.b_zero=0;r.k_zero=k;r.native_level_bottom_first=39-k;r.B=1;r.K=39;}
+    else if(scope==Scope::COLUMN && k==-1){r.b_zero=0;r.B=1;}
+    else throw std::runtime_error("v2 absence scope");
+    if(cause>=data.size() || data[cause].role!=Role::CONSUMED_BOOL_TENSOR || !same_context(r,data[cause])) throw std::runtime_error("v2 borrowed causal predicate");
+    append(std::move(r));
+}
+const std::vector<Record>& records(){auto c=context_snapshot();check_context(c);return data;}
+void clear(){data.clear();ordinals.clear();epoch=0;}
+}
+#endif
