+// A5_SCALAR_HELPER_BEGIN
+inline void scalar_integral(const char* stage,const char* field,const char* source_hook,
+                            Dtype dtype,std::uint64_t bits) {
+    if (!batch5::enabled()) return;
+    using ScalarKey=std::tuple<std::uint64_t,std::uint64_t,std::string,std::uint64_t,std::string,std::string,std::string,int>;
+    static thread_local std::uint64_t epoch=0;
+    static thread_local std::map<ScalarKey,std::uint64_t> ordinals;
+    auto c=batch5::context_snapshot();
+    if(epoch!=c.epoch){ordinals.clear();epoch=c.epoch;}
+    ScalarKey key{c.one_step_call,c.outer_loop,c.family,c.substep_n,stage,field,source_hook,int(dtype)};
+    auto it=ordinals.find(key);const auto ord=it==ordinals.end()?0:it->second;
+    control(stage,field,source_hook,dtype,bits,ord);
+    ordinals[key]=ord+1;
+}
+// A5_SCALAR_HELPER_END
 } // A2_DIAG_HELPER_END
 #endif
