{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kdm6ad:s9-source-build-manifest:v1",
  "title": "KDM6AD S9 source-to-build lineage manifest",
  "description": "Evidence shape contract for the S9 source/build verifier. Schema validation alone is never certification; harness/verify_s9_source_build_manifest.py checks completeness, path/hash-bound edges, archive membership, build receipts, and observed loader identity before accepting a proven gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "recorded_at_utc",
    "source_tree",
    "toolchain",
    "build_steps",
    "artifacts",
    "lineage_gate",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "s9-source-build-manifest/v1" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "recorded_at_utc": { "type": "string", "format": "date-time" },
    "source_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_revision", "public_revision", "dirty", "files"],
      "properties": {
        "host_revision": { "type": "string", "minLength": 1 },
        "public_revision": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" },
        "dirty_diff_sha256": { "$ref": "#/$defs/sha256OrNull" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceFile" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "dirty": { "const": true } } },
          "then": {
            "required": ["dirty_diff_sha256"],
            "properties": { "dirty_diff_sha256": { "$ref": "#/$defs/sha256" } }
          }
        }
      ]
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "compiler", "linker", "build_system", "mpi_launcher", "environment"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "compiler": { "$ref": "#/$defs/toolIdentity" },
        "linker": { "$ref": "#/$defs/toolIdentity" },
        "build_system": { "$ref": "#/$defs/toolIdentity" },
        "mpi_launcher": { "$ref": "#/$defs/toolIdentity" },
        "environment": {
          "type": "object",
          "description": "Exact relevant environment values; secrets must be omitted and their absence noted in limitations.",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "build_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/buildStep" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "runtime_loader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_level", "executable_sha256", "install_names", "rpaths"],
      "properties": {
        "evidence_level": { "enum": ["static_macho_only", "unverified_loader", "observed_loader_resolution"] },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "install_names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rpaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_resolution": { "$ref": "#/$defs/artifactRef" },
        "expected_library": { "$ref": "#/$defs/artifactRef" },
        "observation_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "capture_receipt": { "$ref": "#/$defs/artifactRef" },
        "capture_stdout": { "$ref": "#/$defs/artifactRef" },
        "capture_stderr": { "$ref": "#/$defs/artifactRef" },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "manifest_id", "capture_tool_path", "capture_tool_sha256", "capture_argv", "process_argv", "launcher_sha256", "process_cwd", "process_environment", "process_environment_sha256", "process_exit_code", "executable", "loaded_library", "stdout_sha256", "stderr_sha256", "dyld_image_lines", "private_receipt_sha256"],
          "properties": {
            "schema_version": { "const": "s9-dyld-capture/v1" },
            "manifest_id": { "type": "string", "minLength": 1 },
            "capture_tool_path": { "const": "harness/capture_s9_dyld.py" },
            "capture_tool_sha256": { "$ref": "#/$defs/sha256" },
            "capture_argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "process_argv": { "type": "array", "minItems": 4, "items": { "type": "string" } },
            "launcher_sha256": { "$ref": "#/$defs/sha256" },
            "process_cwd": { "type": "string", "minLength": 1 },
            "process_environment": { "type": "object", "additionalProperties": { "type": "string" } },
            "process_environment_sha256": { "$ref": "#/$defs/sha256" },
            "process_exit_code": { "type": "integer" },
            "executable": { "$ref": "#/$defs/artifactRef" },
            "loaded_library": { "$ref": "#/$defs/artifactRef" },
            "stdout_sha256": { "$ref": "#/$defs/sha256" },
            "stderr_sha256": { "$ref": "#/$defs/sha256" },
            "dyld_image_lines": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "private_receipt_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "evidence_level": { "const": "observed_loader_resolution" } } },
          "then": { "required": ["observed_resolution", "observation_receipt_sha256", "capture_receipt", "capture_stdout", "capture_stderr", "capture"] }
        },
        {
          "if": { "properties": { "evidence_level": { "const": "unverified_loader" } } },
          "then": { "required": ["expected_library"] }
        }
      ]
    },
    "lineage_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verifier", "required_edges", "edge_results", "failures"],
      "properties": {
        "status": { "enum": ["unproven", "unverified_loader", "failed", "proven"] },
        "verifier": { "$ref": "#/$defs/toolIdentity" },
        "required_edges": {
          "const": ["preprocesses_to", "compiles_to", "archives_into", "links_into", "installs_as", "resolves_to"]
        },
        "edge_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from_artifact", "to_artifact", "relation", "status", "receipt_sha256"],
            "properties": {
              "from_artifact": { "$ref": "#/$defs/artifactRef" },
              "to_artifact": { "$ref": "#/$defs/artifactRef" },
              "relation": { "enum": ["preprocesses_to", "compiles_to", "archives_into", "links_into", "installs_as", "resolves_to"] },
              "status": { "enum": ["unproven", "failed", "proven"] },
              "receipt_sha256": { "$ref": "#/$defs/sha256" },
              "reason": { "type": "string" }
            }
          }
        },
        "failures": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "proven" } } },
          "then": {
            "required": ["required_edges"],
            "properties": {
              "edge_results": {
                "minItems": 1,
                "items": { "properties": { "status": { "const": "proven" } } }
              },
              "failures": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "lineage_gate": { "properties": { "status": { "const": "proven" } }, "required": ["status"] } } },
      "then": {
        "required": ["runtime_loader"],
        "properties": {
          "runtime_loader": {
            "properties": { "evidence_level": { "const": "observed_loader_resolution" } },
            "required": ["evidence_level"]
          }
        }
      }
    },
    {
      "if": { "properties": { "lineage_gate": { "properties": { "status": { "const": "unverified_loader" } }, "required": ["status"] } } },
      "then": {
        "required": ["runtime_loader"],
          "properties": {
            "runtime_loader": {
            "properties": { "evidence_level": { "enum": ["unverified_loader", "observed_loader_resolution"] } },
            "required": ["evidence_level"]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha256OrNull": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "role", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "role": { "enum": ["fortran_source", "c_source", "cpp_source", "header", "makefile", "configure", "generated_input", "namelist", "other"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "buildStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "kind", "cwd", "argv", "environment", "stdout_receipt", "stderr_receipt", "inputs", "outputs"],
      "properties": {
        "step_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["configure", "preprocess", "compile", "archive", "link", "install", "loader_inspection", "loader_observation"] },
        "cwd": { "type": "string", "minLength": 1 },
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "environment": { "type": "object", "additionalProperties": { "type": "string" } },
        "stdout_receipt": { "$ref": "#/$defs/artifactRef" },
        "stderr_receipt": { "$ref": "#/$defs/artifactRef" },
        "capture_receipt": { "$ref": "#/$defs/artifactRef" },
        "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifactRef" } },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifactRef" } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "loader_observation" } } },
          "then": { "required": ["capture_receipt"] }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "path", "sha256", "mtime_utc"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["source", "preprocessed_source", "object", "module_file", "archive", "executable", "shared_library", "symlink", "receipt", "other"] },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mtime_utc": { "type": ["string", "null"], "format": "date-time" },
        "symlink_target": { "type": "string" },
        "archive_members": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } },
        "member_inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "archive" } } },
          "then": { "required": ["archive_members", "member_inventory"] }
        }
      ]
    }
  }
}
