#!/usr/bin/env python3
"""Predeclare, then optionally run direct RTTOV H sensitivity on saved native frames.

Default invocation writes a predeclaration only. The explicit one-shot execution
path evaluates H(host(t)) at three already-saved times and two explicitly named
RTTOV profile-elevation assumptions. It does not call the KDM model M step.
"""
from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
from pathlib import Path
import re
import sys
import time

import numpy as np
import torch

ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT / "oracle"))
from kdm6.da_driver import batched_allsky_bt  # noqa: E402
PACKET = ROOT / "harness/evidence/pr398_followup_2026-10-10"
OUT = ROOT / "graphify-out/pr398-time-geometry-sensitivity-2026-10-10"
PRIVATE = OUT / "private"
PLAN = PACKET / "PREDECLARED.json"
STARTED = PRIVATE / "STARTED_ONCE.json"
RESULT = PRIVATE / "RESULT.json"
FAILURE = PRIVATE / "FAILURE.json"
INTAKE_MANIFEST = ROOT / "harness/evidence/pr395_native_tq_intake_2026-10-10/INTAKE.json"
INTAKE_NPZ = ROOT / "graphify-out/pr395-native-tq-intake-2026-10-10/private/native_column_8frame.npz"
OBS_RECEIPT = ROOT / "harness/evidence/pr395_observation_matchup_2026-10-10/RECEIPT.json"
CAPTURE_RECEIPT = ROOT / "harness/evidence/pr395_tq_state_capture_2026-10-10/RESULT_3d2e97f159.json"
DRIVER_RECEIPT = ROOT / "harness/evidence/pr395_tq_state_capture_2026-10-10/DRIVER_3d2e97f159.json"
ANALYSIS_DRIVER = ROOT / "harness/evidence/pr395_native_tq_intake_2026-10-10/run_analysis.py"
NATIVE_READER = ROOT / "harness/evidence/native358_artifact_diag_2026-10-08/recipe/run_native_kma_bt_frames.py"
CHANNELS = tuple(range(10, 17))
CHANNEL_NAMES = ("wv073", "ir087", "ir096", "ir105", "ir112", "ir123", "ir133")
FRAME_INDICES = (1, 4, 6)
EXPECTED_TIMES = (
    "2025-07-19_05:56:00",
    "2025-07-19_05:57:00",
    "2025-07-19_05:57:40",
)
CTH_M = 587.7369384765625
F64 = {"dtype": torch.float64}


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with Path(path).open("rb") as stream:
        for chunk in iter(lambda: stream.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def array_sha256(value) -> str:
    return hashlib.sha256(np.ascontiguousarray(value).tobytes()).hexdigest()


def load_module(path: Path, name: str):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot import source module {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _input_context():
    analysis = load_module(ANALYSIS_DRIVER, "pr398_pinned_run_analysis")
    binding, arrays = analysis.require_valid_intake(INTAKE_MANIFEST, INTAKE_NPZ)
    observation = json.loads(OBS_RECEIPT.read_text())
    capture = json.loads(CAPTURE_RECEIPT.read_text())
    driver = json.loads(DRIVER_RECEIPT.read_text())
    if (driver.get("schema") != "pr395_native_tq_analysis_driver_v1"
            or driver.get("status") != "RETURNED_DIAGNOSTIC_ONLY"
            or driver.get("objective_audit", {}).get("status") != "CROSSCHECKED"
            or driver.get("intake_npz_sha256") != binding["npz_sha256"]
            or driver.get("intake_manifest_sha256") != binding["manifest_sha256"]
            or driver.get("capture_receipt_sha256") != sha256(CAPTURE_RECEIPT)
            or driver.get("rttov_execution_assets_stable_during_analysis") is not True
            or driver.get("rttov_execution_assets_before") != driver.get("rttov_execution_assets_after")):
        raise ValueError("the accepted one-shot baseline receipt does not bind this native intake")
    source_assets = _source_asset_map(analysis)
    baseline_assets = driver.get("rttov_execution_assets_before", {})
    for driver_name, source_name in (("run_sh", "run_sh"), ("env_sh", "env_sh"),
                                    ("executable", "rttov_executable"),
                                    ("coefficient", "rttov_coefficient")):
        if baseline_assets.get(driver_name, {}).get("sha256") != source_assets[source_name]["sha256"]:
            raise ValueError(f"baseline RTTOV {driver_name} differs from the pinned template asset")
    zero = capture.get("objective", {}).get("initial_zero_control_closure", {})
    mask = np.asarray(zero.get("frozen_mask", {}).get("values"), dtype=np.float64)
    if (capture.get("status") != "RETURNED_DIAGNOSTIC_ONLY"
            or zero.get("trace_index") != 0 or zero.get("n_valid") != 7
            or mask.shape != (1, 7) or not np.array_equal(mask, np.ones((1, 7)))
            or capture.get("objective", {}).get("final_rad_quality") != [[0.0] * 7]
            or zero.get("frozen_mask", {}).get("sha256_f64") != array_sha256(mask)
            or zero.get("signature_matches_final_accepted_audit") is not True):
        raise ValueError("baseline initial closure does not establish the frozen all-seven support")
    if observation.get("schema") != "pr395_observation_matchup_receipt_v1":
        raise ValueError("unexpected fixed observation receipt")
    candidate = observation["ami_candidate_result"]
    if (observation["fixed_candidate"].get("native_j_i_zero_based") != [86, 48]
            or candidate.get("row_col_zero_based") != [320, 48]
            or observation["channel_order"][2:9] != list(CHANNEL_NAMES)):
        raise ValueError("candidate or channel identity changed from the fixed PR395 packet")
    dqf = np.asarray(candidate["dqf"][2:9], dtype=np.float64).reshape(1, 7)
    target = np.asarray(candidate["bt_K"][2:9], dtype=np.float64).reshape(1, 7)
    if not np.isfinite(target).all() or not np.all(dqf == 0.0):
        raise ValueError("predeclared seven-channel observations must be finite and QC-good")
    if not np.array_equal(mask, (dqf == 0.0).astype(np.float64)):
        raise ValueError("baseline frozen support differs from the observation DQF policy")
    actual_h = driver["analysis_result"]["actual_h_configuration"]
    metadata = driver["analysis_result"]["adapter_metadata"]
    baseline_target = np.asarray(driver["analysis_result"]["observations"]["y_bt_K"], dtype=np.float64)
    if (tuple(actual_h.get("channels", ())) != CHANNELS
            or actual_h.get("ami_kma_bt") is not True
            or actual_h.get("dry_number") is not True
            or actual_h.get("ncmin_land") != 10.0
            or actual_h.get("ncmin_sea") != 10.0
            or actual_h.get("t_blend_octaves") != 0.0
            or actual_h.get("q_blend_octaves") != 0.0
            or metadata.get("observation_sigma_K") != 1.0
            or metadata.get("observation_bias_K") != 0.0
            or metadata.get("huber_delta_K") != 1.0
            or metadata.get("obs_time") != 1
            or metadata.get("background_mask") != mask.tolist()
            or not np.array_equal(baseline_target, target)):
        raise ValueError("sensitivity channel, cost, quality, or operator policy differs from the accepted baseline")
    manifest = binding["manifest"]
    actual_times = manifest["native_run"]["actual_saved_times"]
    if tuple(actual_times[i] for i in FRAME_INDICES) != EXPECTED_TIMES:
        raise ValueError("predeclared direct-H frames differ from the exact saved-time labels")
    if (manifest.get("science_approved") is not False
            or manifest.get("analysis_executed") is not False):
        raise ValueError("native intake must remain science-unapproved and analysis-unexecuted")
    return analysis, binding, arrays, observation, candidate, capture, driver, target, dqf, mask


def _native_frame(arrays: dict[str, np.ndarray], index: int) -> dict:
    return {
        "p_pa": arrays["native_window_forcing__p"][index],
        "th": arrays["native_window_state__th"][index],
        "pii": arrays["native_window_forcing__pii"][index],
        "p8w_pa": arrays["native_window_p_half_calc_p8w_bottomup_Pa"][index],
        "state": {"QVAPOR": arrays["wrf_raw__QVAPOR"][index]},
    }


def _source_asset_map(analysis) -> dict:
    fixture = analysis.TEMPLATE_FIXTURE.resolve()
    run_script = fixture / "out/run.sh"
    matches = re.findall(r"(?m)^\s*(/[^\s]+rttov_test\.exe)\b", run_script.read_text())
    if len(matches) != 1:
        raise ValueError("pinned RTTOV template must identify one absolute rttov_test executable")
    exe = Path(matches[0]).resolve()
    coef = analysis._resolve_coef_path(fixture)
    if not exe.is_file() or not coef.is_file():
        raise FileNotFoundError("pinned RTTOV executable or coefficient file is missing")
    paths = {
        "run_sh": run_script,
        "env_sh": fixture / "out/env.sh",
        "rttov_test_namelist": fixture / "out/rttov_test.txt",
        "template_p": fixture / "in/profiles/001/atm/p.txt",
        "template_p_half": fixture / "in/profiles/001/atm/p_half.txt",
        "template_o3": fixture / "in/profiles/001/atm/o3.txt",
        "template_co2": fixture / "in/profiles/001/atm/co2.txt",
        "rttov_executable": exe,
        "rttov_coefficient": coef,
    }
    return {name: {"path": str(path), "sha256": sha256(path)} for name, path in paths.items()}


def _geometry_cases(analysis, reader, candidate, arrays, index: int) -> list[dict]:
    hgt_m = float(arrays["native_surface__HGT"][index])
    if not np.isfinite(hgt_m):
        raise ValueError("selected native HGT must be finite")
    ami = {"ami_lat_lon": candidate["latitude_longitude"],
           "ami_metadata": {"geos": candidate["geos"]}}
    nominal, derivation = reader.ami_geometry(ami, candidate["geos"], hgt_m / 1000.0)
    # The implementation's elevation field is RTTOV profile surface elevation
    # in km. It is not a cloud-height argument and does not move the line of sight.
    cth_case = dict(nominal)
    cth_case["elevation"] = CTH_M / 1000.0
    return [
        {"id": "nominal_native_surface_elevation",
         "geometry": nominal, "height_assumption": "native selected WRF HGT",
         "derivation": derivation},
        {"id": "conditional_CTH_as_RTTOV_elevation_assumption",
         "geometry": cth_case,
         "height_assumption": "CloudHeight CTH used only as an explicit RTTOV surface-elevation sensitivity; datum is unverified",
         "derivation": derivation,
         "interpretation_limit": "not a physical surface-height claim, not a cloud-top displacement, and not a satellite line-of-sight parallax correction"},
    ]


def _plan_payload() -> dict:
    analysis, binding, arrays, observation, candidate, capture, driver, target, dqf, frozen_mask = _input_context()
    reader = analysis.load_module(NATIVE_READER, "pr398_saved_frame_profile_reader")
    reference = reader.load_reference()
    times = binding["manifest"]["native_run"]["actual_saved_times"]
    matrix = []
    for index in FRAME_INDICES:
        frame = _native_frame(arrays, index)
        p_lay, p_half, t, q, o3, co2 = reader.extend_above_native_top(frame, reference)
        if (len(p_lay), len(p_half)) != (66, 67):
            raise ValueError(f"saved frame {index} does not form the predeclared 66/67 RTTOV grid")
        for geometry_case in _geometry_cases(analysis, reader, candidate, arrays, index):
            matrix.append({
                "case_id": f"frame{index}_{geometry_case['id']}",
                "frame_index": index,
                "native_time_label": times[index],
                "operator_semantics": "direct H(native saved State_t, Forcing_t); no KDM M step and no temporal interpolation",
                "state_sha256_by_field": {
                    key: array_sha256(arrays[key][index:index+1])
                    for key in arrays if key.startswith("native_window_state__")
                },
                "forcing_sha256_by_field": {
                    field: array_sha256(arrays[f"native_window_forcing__{field}"][index:index+1])
                    for field in ("rho", "pii", "p", "delz")
                },
                "p8w_sha256": array_sha256(frame["p8w_pa"]),
                "rho_d_sha256": array_sha256(
                    arrays["native_window_forcing__rho"][index] /
                    (1.0 + arrays["native_window_state__qv"][index])),
                "surface_sha256_by_field": {
                    field: array_sha256(arrays[f"native_surface__{field}"][index:index+1])
                    for field in ("TSK", "T2", "Q2", "U10", "V10", "HGT", "xland",
                                  "seaice", "latitude_deg", "longitude_deg")
                },
                "rttov_profile_sha256": {
                    "p_lay_hPa": array_sha256(p_lay), "p_half_hPa": array_sha256(p_half),
                    "t_native_plus_fixed_upper_reference_K": array_sha256(t),
                    "q_native_plus_fixed_upper_reference_ppmv": array_sha256(q),
                    "o3_ppmv": array_sha256(o3), "co2_ppmv": array_sha256(co2),
                },
                "profile_layers_interfaces": [len(p_lay), len(p_half)],
                "geometry_scenario": geometry_case["id"],
                "geometry": geometry_case["geometry"],
                "height_assumption": geometry_case["height_assumption"],
                "geometry_derivation": geometry_case["derivation"],
                "interpretation_limit": geometry_case.get("interpretation_limit"),
            })
    scene_time = observation.get("ami_clock", {}).get(
        "conditional_full_image_interval_utc_if_sync_offset_constant")
    source_assets = _source_asset_map(analysis)
    source_paths = {
        "analysis_driver": ANALYSIS_DRIVER,
        "native_reader": NATIVE_READER,
        "intake_consumer": PACKET.parent / "pr395_native_tq_intake_2026-10-10/intake_native_tq.py",
        "rttov_case_writer": ROOT / "oracle/kdm6/obs/rttov_case_writer.py",
        "rttov_input_builder": ROOT / "oracle/kdm6/obs/rttov_input_builder.py",
        "rttov_runner": ROOT / "oracle/kdm6/obs/rttov_runner.py",
        "ami_bt_coordinate": ROOT / "oracle/kdm6/obs/ami_bt_coordinate.py",
        "model_profile_builder": ROOT / "oracle/kdm6/obs/model_profile_builder.py",
        "allsky_shard": ROOT / "oracle/kdm6/obs/allsky_shard.py",
        "allsky_observation_operator": ROOT / "oracle/kdm6/obs/rttov_obs_operator.py",
        "allsky_column_driver": ROOT / "oracle/kdm6/da_driver.py",
        "observation_loss": ROOT / "oracle/kdm6/obs/obs_loss.py",
    }
    return {
        "schema": "pr398_time_geometry_sensitivity_plan_v1",
        "status": "PREDECLARED_NO_RTTOV_EXECUTED",
        "created_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "scope": "one sequential direct-H batch on saved native frames; no WRF rerun, no KDM integration, no interpolation, no new column, no external model or reanalysis",
        "intake": {"manifest_path": str(INTAKE_MANIFEST),
                   "manifest_sha256": binding["manifest_sha256"],
                   "npz_path": str(INTAKE_NPZ), "npz_sha256": binding["npz_sha256"],
                   "native_run_id": binding["manifest"]["native_run"]["run_id"],
                   "selected_column": binding["manifest"]["selected_column"]},
        "baseline_analysis_binding": {
            "capture_receipt_path": str(CAPTURE_RECEIPT),
            "capture_receipt_sha256": sha256(CAPTURE_RECEIPT),
            "driver_receipt_path": str(DRIVER_RECEIPT),
            "driver_receipt_sha256": sha256(DRIVER_RECEIPT),
            "initial_zero_control_operator_signature_sha256": capture["objective"]["initial_zero_control_closure"]["operator_signature_sha256"],
            "frozen_mask": frozen_mask.tolist(),
            "frozen_mask_sha256_f64": capture["objective"]["initial_zero_control_closure"]["frozen_mask"]["sha256_f64"],
            "frozen_support_n_valid": int(np.count_nonzero(frozen_mask)),
            "baseline_rttov_execution_assets": driver["rttov_execution_assets_before"],
        },
        "predeclared_times": [{"frame_index": index, "time_label": times[index],
                                "role": ("nominal 20 s slot; model/observation alignment only, pixel time unverified"
                                         if index == 1 else "saved frame inside conditional AMI scene interval; not per-pixel UTC")}
                               for index in FRAME_INDICES],
        "time_context": {
            "conditional_ami_scene_interval": scene_time,
            "interval_source": "observation receipt conditional AMI file-level interval; exact per-pixel UTC and synchronization not established",
            "times_are_exact_native_saved_labels": True,
            "time_interpolation": False,
        },
        "observations_and_support": {
            "ami_candidate_row_col_zero_based": candidate["row_col_zero_based"],
            "native_j_i_zero_based": [86, 48],
            "observation_receipt_sha256": sha256(OBS_RECEIPT),
            "channels_1based": list(CHANNELS), "channel_names": list(CHANNEL_NAMES),
            "target_bt_sha256_f64": array_sha256(target),
            "observation_dqf": dqf.tolist(),
            "sigma_K": 1.0, "bias_K": 0.0, "huber_delta_K": 1.0,
            "quality_policy": "use exactly the baseline initial-closure frozen all-seven mask; each direct H must retain rad_quality=0 on all seven to receive a cost; never shrink or recompute a favorable subset",
            "frozen_mask": frozen_mask.tolist(),
        },
        "geometry_policy": {
            "viewing_latitude_longitude": candidate["latitude_longitude"],
            "viewing_angle_method": "archived ami_geometry ECEF satellite-minus-ellipsoid-point line of sight from fixed AMI candidate and GEOS; sun angles explicitly zero for solar-disabled thermal run",
            "nominal_elevation_source": "selected frame's native WRF HGT converted to RTTOV elevation km (observed HGT is recorded per frame)",
            "height_sensitivity": "second geometry case changes only RTTOV &angles elevation to the selected 587.7369384765625 m CTH value expressed in km; datum is unverified and it is only a declared input assumption",
            "not_parallax": "this does not recompute lat/lon, move the AMI ray intersection, use the product's corrected VIIRS coordinate, verify footprint overlap, or reassign the native column; it is RTTOV profile-elevation sensitivity only",
            "cth_source_limit": "observation receipt reports CTH 587.7369384765625 m, but the height datum is not established and the full CloudHeight file was not downloaded or full-file hashed",
            "native_grid_location_reassignment": False,
        },
        "profile_policy": {
            "state_forcing_surface_and_eos_optical_density": "each selected frame's own saved arrays; rho_d=Forcing.rho/(1+State.qv)",
            "pressure": "per-frame native centers and REAL(4)-transcribed P8W interfaces; rebuild each frame's 39-native-plus-27-reference profile grid and update its isolated fixture pressure/gas files before H",
            "raw_PH_PHB": "preserved by intake; not substituted for P8W pressure interfaces",
            "dry_number": True, "ami_kma_bt": True, "ncmin_land": 10.0, "ncmin_sea": 10.0,
            "t_q_blend_octaves": 0.0,
            "upper_reference": binding["manifest"]["upper_reference_assumption"],
            "template_role": "retained RTTOV coefficient/test-driver and static sea-surface parameters; per-case native pressure, gases, T/Q/cloud, geometry, and dynamic surface are supplied explicitly",
        },
        "planned_cases": matrix,
        "planned_case_count": len(matrix),
        "execution": {
            "order": "serial in listed case order; one external RTTOV runK per case",
            "rttov_timeout_s": analysis.DEFAULT_RTTOV_TIMEOUT,
            "automatic_retry": False,
            "process_M_calls": 0,
            "prior_BT_reused": False,
            "rttov_assets": source_assets,
            "source_sha256": {name: sha256(path) for name, path in source_paths.items()},
            "actual_BT_available": False,
        },
        "limits": [
            "H(host(t)) is not H(M(xb)); none of these direct snapshots advances KDM6.",
            "The 05:57:00 and 05:57:40 labels fall inside the conditional file-level AMI scene interval only under its recorded synchronization assumption; per-pixel UTC remains unverified.",
            "The CTH-as-elevation case is an explicit RTTOV elevation input sensitivity, not validated cloud-top parallax or a geolocation correction.",
            "No time, geometry, surface, or model-column scenario will be selected after seeing BT results; the full 3x2 matrix and support gate are fixed here.",
        ],
    }


def write_plan() -> None:
    if OUT.exists() or PLAN.exists():
        raise FileExistsError(f"predeclared output root or packet manifest already exists: {OUT} / {PLAN}")
    OUT.mkdir(mode=0o700, parents=True)
    OUT.chmod(0o700)
    PRIVATE.mkdir(mode=0o700)
    PRIVATE.chmod(0o700)
    payload = _plan_payload()
    payload["driver_sha256"] = sha256(Path(__file__))
    with PLAN.open("x") as stream:
        json.dump(payload, stream, indent=2, sort_keys=True, allow_nan=False)
        stream.write("\n")
    PLAN.chmod(0o644)
    print(json.dumps({"status": payload["status"], "plan": str(PLAN),
                      "planned_case_count": payload["planned_case_count"],
                      "driver_sha256": payload["driver_sha256"],
                      "rttov_executed": False}, indent=2))


def _load_plan_context():
    if not PLAN.is_file():
        raise FileNotFoundError(f"run plan-only first; missing {PLAN}")
    plan = json.loads(PLAN.read_text())
    if plan.get("schema") != "pr398_time_geometry_sensitivity_plan_v1" or plan.get("status") != "PREDECLARED_NO_RTTOV_EXECUTED":
        raise ValueError("unexpected predeclaration manifest")
    if plan.get("driver_sha256") != sha256(Path(__file__)):
        raise ValueError("sensitivity driver changed after predeclaration")
    analysis, binding, arrays, observation, candidate, capture, driver, target, dqf, mask = _input_context()
    if (binding["manifest_sha256"] != plan["intake"]["manifest_sha256"]
            or binding["npz_sha256"] != plan["intake"]["npz_sha256"]
            or sha256(CAPTURE_RECEIPT) != plan["baseline_analysis_binding"]["capture_receipt_sha256"]
            or sha256(DRIVER_RECEIPT) != plan["baseline_analysis_binding"]["driver_receipt_sha256"]):
        raise ValueError("intake or baseline capture changed after scenario predeclaration")
    reader = analysis.load_module(NATIVE_READER, "pr398_execution_native_reader")
    reference = reader.load_reference()
    return analysis, binding, arrays, observation, candidate, target, dqf, mask, reader, reference, plan


def _surface_for_frame(analysis, arrays: dict[str, np.ndarray], index: int) -> dict:
    skin_path = analysis.TEMPLATE_FIXTURE / "in/profiles/001/sfc/01/skin.txt"
    skin = analysis._read_scalar_fields(skin_path, "k0")
    skin["t"] = float(arrays["native_surface__TSK"][index])
    q2 = torch.as_tensor([float(arrays["native_surface__Q2"][index])], **F64)
    q2_ppmv = float(analysis.qv_to_q_ppmv_moist(
        q2, gas_units=2, qv_convention="mixing_ratio_kgkg_dry")[0])
    return {
        "skin": skin,
        "near_surface": {
            "t2m": float(arrays["native_surface__T2"][index]),
            "q2m": q2_ppmv,
            "wind_u10m": float(arrays["native_surface__U10"][index]),
            "wind_v10m": float(arrays["native_surface__V10"][index]),
            "wind_fetch": 0.0,
        },
    }


def _write_frame_profile_fixture(analysis, arrays: dict[str, np.ndarray], fixture_copy: Path,
                                 frame: dict, profile: tuple[np.ndarray, ...]) -> dict:
    p_lay, p_half, t, q, o3, co2 = profile
    atm = fixture_copy / "in/profiles/001/atm"
    analysis._write_vector(atm / "p.txt", p_lay)
    analysis._write_vector(atm / "p_half.txt", p_half)
    analysis._write_vector(atm / "o3.txt", o3)
    analysis._write_vector(atm / "co2.txt", co2)
    return {name: sha256(atm / name) for name in ("p.txt", "p_half.txt", "o3.txt", "co2.txt")}


def _run_case(case: dict, analysis, arrays: dict[str, np.ndarray], observation: dict,
              candidate: dict, target: np.ndarray, dqf: np.ndarray, frozen_mask: np.ndarray,
              reader, reference: dict, run_root: Path) -> dict:
    index = int(case["frame_index"])
    frame_arrays = _native_frame(arrays, index)
    profile = reader.extend_above_native_top(frame_arrays, reference)
    p_lay, p_half, t_profile, q_profile, o3, co2 = profile
    state = analysis.State(*(torch.as_tensor(
        arrays[f"native_window_state__{field}"][index:index+1], **F64)
        for field in analysis.State._fields))
    forcing = analysis.Forcing(**{
        field: torch.as_tensor(arrays[f"native_window_forcing__{field}"][index:index+1], **F64)
        for field in analysis.Forcing._fields})
    rho_d = forcing.rho / (1.0 + state.qv)
    xland_value = float(arrays["native_surface__xland"][index])
    seaice = float(arrays["native_surface__seaice"][index]) if "native_surface__seaice" in arrays else 0.0
    if xland_value != 2.0 or seaice != 0.0:
        raise ValueError(f"frame {index} no longer matches the fixed open-ocean selected column")
    surface = _surface_for_frame(analysis, arrays, index)
    geometry = dict(case["geometry"])

    case_id = case["case_id"]
    fixture_copy = run_root / f"fixture-{case_id}"
    fixture_source_info = analysis._prepare_fixture_copy(
        analysis.TEMPLATE_FIXTURE.resolve(), fixture_copy, arrays)
    fixture_profile_hashes = _write_frame_profile_fixture(
        analysis, arrays, fixture_copy, frame_arrays, profile)
    for name, digest in fixture_profile_hashes.items():
        fixture_source_info["prepared_files_sha256"][f"in/profiles/001/atm/{name}"] = digest
    case_dir = run_root / f"hcase-{case_id}"
    if case_dir.exists():
        raise FileExistsError(case_dir)
    input_cfg = analysis.RttovInputConfig(
        "paired-case_00-GK2A-AMI", CHANNELS, surface=surface, geometry=geometry)
    profile_cfg = analysis.RttovProfileConfig(
        gas_units=2, qv_convention="mixing_ratio_kgkg_dry",
        rttov_layer_pressure=torch.as_tensor(p_lay, **F64),
        rttov_level_pressure=torch.as_tensor(p_half, **F64), cloud=True,
        rho_d=rho_d, dry_number=True)
    run_k = analysis.make_live_run_k(
        case_dir, fixture_case_dir=fixture_copy,
        timeout=analysis.DEFAULT_RTTOV_TIMEOUT, ami_kma_bt=True)
    obs_cfg = analysis.OsseObsConfig(
        run_k=run_k, profile_cfg=profile_cfg, input_cfg=input_cfg,
        obs_sigma=1.0, t_ref=torch.as_tensor(t_profile, **F64),
        q_ref=torch.as_tensor(q_profile, **F64), t_blend_octaves=0.0,
        q_blend_octaves=0.0)

    # This is the value-only direct observation path. No forward model M is called,
    # and the returned RTTOV K is never backpropagated.
    with torch.no_grad():
        bt, rad_quality, _ = batched_allsky_bt(
            state, forcing, obs_cfg,
            xland=torch.as_tensor([xland_value], **F64),
            ncmin_land=10.0, ncmin_sea=10.0)
    bt_np = bt.detach().cpu().numpy()
    rq_np = rad_quality.detach().cpu().numpy().astype(np.float64)
    quality_ok = bool(np.array_equal(rq_np, np.zeros((1, 7), dtype=np.float64)))
    jo = None
    if quality_ok:
        jo = float(analysis.compute_obs_loss(
            torch.as_tensor(bt_np, **F64),
            {"bt": torch.as_tensor(target, **F64), "bias": 0.0},
            torch.as_tensor(frozen_mask, **F64), 1.0, delta=1.0))
    assets = {
        "fixture_source": fixture_source_info,
        "per_frame_pressure_gas_files_sha256": fixture_profile_hashes,
        "rttov_run_sh_sha256": sha256(fixture_copy / "out/run.sh"),
        "rttov_env_sh_sha256": sha256(fixture_copy / "out/env.sh"),
        "executable_sha256": fixture_source_info["rttov_executable"]["sha256"],
        "coefficient_sha256": fixture_source_info["ami_coefficient"]["sha256"],
    }
    return {
        "case_id": case_id, "frame_index": index,
        "native_time_label": case["native_time_label"],
        "status": "H_RETURNED" if quality_ok else "H_RETURNED_QUALITY_GATE_FAILED",
        "operator_semantics": "H(native saved frame); no M step, interpolation, or backward",
        "geometry_scenario": case["geometry_scenario"],
        "geometry": geometry,
        "channels_1based": list(CHANNELS), "channel_names": list(CHANNEL_NAMES),
        "BT_K": bt_np.tolist(), "rad_quality": rq_np.tolist(),
        "fixed_observation_quality_DQF": dqf.tolist(),
        "frozen_support": frozen_mask.tolist(),
        "frozen_support_n_valid": int(np.count_nonzero(frozen_mask)),
        "all_seven_rad_quality_zero": quality_ok,
        "Jo_huber_K_units": jo,
        "cost_formula": "sum frozen_mask * Huber((BT-target_BT-bias)/sigma); sigma=1 K, bias=0 K, delta=1 K; null when any frozen-support rad_quality is nonzero",
        "state_sha256_by_field": case["state_sha256_by_field"],
        "forcing_sha256_by_field": case["forcing_sha256_by_field"],
        "rho_d_sha256": case["rho_d_sha256"],
        "rttov_profile_sha256": case["rttov_profile_sha256"],
        "rttov_assets": assets,
        "case_output_dir": str(case_dir),
        "no_model_or_rttov_retry": True,
    }


def execute_one_shot() -> int:
    analysis, binding, arrays, observation, candidate, target, dqf, frozen_mask, reader, reference, plan = _load_plan_context()
    if STARTED.exists() or RESULT.exists() or FAILURE.exists():
        raise FileExistsError("one-shot sensitivity execution was already claimed or returned")
    with STARTED.open("x") as stream:
        json.dump({"status": "STARTED_ONCE", "plan_sha256": sha256(PLAN),
                   "driver_sha256": sha256(Path(__file__)),
                   "intake_npz_sha256": binding["npz_sha256"],
                   "case_count": plan["planned_case_count"]}, stream, indent=2)
        stream.write("\n")
    STARTED.chmod(0o600)
    results = []
    try:
        for case in plan["planned_cases"]:
            results.append(_run_case(
                case, analysis, arrays, observation, candidate, target, dqf,
                frozen_mask, reader, reference, PRIVATE))
        status = ("ALL_PREDECLARED_CASES_RETURNED" if all(
            row["all_seven_rad_quality_zero"] for row in results)
            else "COMPLETED_WITH_QUALITY_REJECTIONS")
        payload = {
            "schema": "pr398_time_geometry_sensitivity_result_v1",
            "status": status, "plan_path": str(PLAN), "plan_sha256": sha256(PLAN),
            "driver_sha256": sha256(Path(__file__)),
            "native_run_id": binding["manifest"]["native_run"]["run_id"],
            "intake_manifest_sha256": binding["manifest_sha256"],
            "intake_npz_sha256": binding["npz_sha256"],
            "results": results,
            "n_model_M_calls": 0,
            "n_backward_calls": 0,
            "automatic_retry": False,
            "science_accepted": False,
        }
        with RESULT.open("x") as stream:
            json.dump(payload, stream, indent=2, sort_keys=True, allow_nan=False)
            stream.write("\n")
        RESULT.chmod(0o600)
        print(json.dumps({"status": status, "result": str(RESULT),
                          "cases_returned": len(results),
                          "all_seven_support_every_case": all(
                              row["all_seven_rad_quality_zero"] for row in results),
                          "M_calls": 0}, indent=2))
        return 0 if status == "ALL_PREDECLARED_CASES_RETURNED" else 1
    except BaseException as exc:
        payload = {"schema": "pr398_time_geometry_sensitivity_failure_v1",
                   "status": "FAILED_NO_RETRY", "plan_sha256": sha256(PLAN),
                   "error_type": type(exc).__name__, "error": str(exc),
                   "completed_results": results, "automatic_retry": False,
                   "M_calls": 0}
        with FAILURE.open("x") as stream:
            json.dump(payload, stream, indent=2, sort_keys=True, allow_nan=False)
            stream.write("\n")
        FAILURE.chmod(0o600)
        raise


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--plan-only", action="store_true", help="write the immutable scenario plan; no RTTOV")
    mode.add_argument("--execute-one-shot", action="store_true", help="run each predeclared direct-H case once")
    args = parser.parse_args()
    if args.execute_one_shot:
        return execute_one_shot()
    write_plan()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
