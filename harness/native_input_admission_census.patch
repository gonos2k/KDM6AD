--- a/phys/module_mp_kdm6ad_cons.F
+++ b/phys/module_mp_kdm6ad_cons.F
@@ -354,6 +354,115 @@
     CALL kdm6ad_cons_check_finite_3d(DELZ_IN,'DELZ input', ITS, KTS, JTS)
     CALL kdm6ad_cons_check_finite_2d(XLAND_IN,'XLAND input',ITS,JTS)
 
+    ! Input-only census. All reads precede the normal value-only forecast call.
+    BLOCK
+      CHARACTER(LEN=16) :: ENABLED
+      CHARACTER(LEN=512) :: CENSUS_DIR, CENSUS_FILE
+      INTEGER :: ELEN, ESTAT, CLEN, CSTAT, U, IOS, CI, CJ, CK, CF
+      INTEGER :: NUM_COUNT, PAIR_COUNT, ICE_COUNT, SEED_COUNT, ELIG_COUNT, BI, BJ
+      LOGICAL :: NUM_OK, PAIR_OK, ROW_OK, ICE_OK, SEED_OK, PAIR_ROW
+      REAL(c_double) :: ROW(12), FROW(4), RHO_D, NC_FLOOR, SCORE, BEST_SCORE, LAND
+      REAL(c_double) :: BEST_STATE(12,KM), BEST_FORCE(4,KM), BEST_LAND
+      ENABLED = ''
+      CALL get_environment_variable('KDM6_NCCN_INPUT_CENSUS', ENABLED, LENGTH=ELEN, STATUS=ESTAT)
+      IF (ELEN > 0) THEN
+        IF (ESTAT /= 0 .OR. ELEN /= 1) CALL wrf_error_fatal('invalid input census switch')
+        IF (ENABLED(1:1) /= '0' .AND. ENABLED(1:1) /= '1') &
+          CALL wrf_error_fatal('input census switch must be 0 or 1')
+      END IF
+      IF (ELEN == 1 .AND. ENABLED(1:1) == '1') THEN
+        IF (.NOT. DRY_NUMBER_MODE .OR. .NOT. NORMALIZED_ICE_MODE) &
+          CALL wrf_error_fatal('input census requires normalized dry-number variant')
+        CENSUS_DIR = ''
+        CALL get_environment_variable('KDM6_NCCN_CENSUS_DIR', CENSUS_DIR, LENGTH=CLEN, STATUS=CSTAT)
+        IF (CSTAT /= 0 .OR. CLEN <= 0 .OR. CLEN > 400) &
+          CALL wrf_error_fatal('input census requires a unique directory')
+        NUM_COUNT=0; PAIR_COUNT=0; ICE_COUNT=0; SEED_COUNT=0; ELIG_COUNT=0
+        BI=0; BJ=0; BEST_SCORE=-1.0_c_double; BEST_LAND=0.0_c_double
+        DO CJ=1,JM
+          DO CI=1,IM
+            LAND=REAL(XLAND_IN(CI,CJ),c_double)
+            NUM_OK=ieee_is_finite(LAND) .AND. (LAND==1.0_c_double .OR. LAND==2.0_c_double)
+            PAIR_OK=.TRUE.; ICE_OK=.FALSE.; SEED_OK=.FALSE.; SCORE=0.0_c_double
+            NC_FLOOR=REAL(ncmin_land,c_double)
+            IF (LAND>=1.5_c_double) NC_FLOOR=REAL(ncmin_sea,c_double)
+            DO CK=1,KM
+              ROW=[REAL(TH_IN(CI,CK,CJ),c_double),REAL(Q_IN(CI,CK,CJ),c_double), &
+                   REAL(QC_IN(CI,CK,CJ),c_double),REAL(QR_IN(CI,CK,CJ),c_double), &
+                   REAL(QI_IN(CI,CK,CJ),c_double),REAL(QS_IN(CI,CK,CJ),c_double), &
+                   REAL(QG_IN(CI,CK,CJ),c_double),REAL(NN_IN(CI,CK,CJ),c_double), &
+                   REAL(NC_IN(CI,CK,CJ),c_double),REAL(NI_IN(CI,CK,CJ),c_double), &
+                   REAL(NR_IN(CI,CK,CJ),c_double),REAL(BG_IN(CI,CK,CJ),c_double)]
+              FROW=[REAL(DEN_IN(CI,CK,CJ),c_double),REAL(PII_IN(CI,CK,CJ),c_double), &
+                    REAL(P_IN(CI,CK,CJ),c_double),REAL(DELZ_IN(CI,CK,CJ),c_double)]
+              ROW_OK=ALL(ieee_is_finite(ROW)) .AND. ALL(ieee_is_finite(FROW))
+              ROW_OK=ROW_OK .AND. ROW(1)>0.0_c_double .AND. ALL(ROW(2:12)>=0.0_c_double) &
+                     .AND. ALL(FROW>0.0_c_double)
+              NUM_OK=NUM_OK .AND. ROW_OK
+              PAIR_ROW=((ROW(3)==0.0_c_double) .EQV. (ROW(9)==0.0_c_double)) .AND. &
+                       ((ROW(4)==0.0_c_double) .EQV. (ROW(11)==0.0_c_double)) .AND. &
+                       ((ROW(5)==0.0_c_double) .EQV. (ROW(10)==0.0_c_double)) .AND. &
+                       ((ROW(7)==0.0_c_double) .EQV. (ROW(12)==0.0_c_double))
+              PAIR_OK=PAIR_OK .AND. PAIR_ROW
+              IF (ROW_OK) THEN
+                RHO_D=FROW(1)/(1.0_c_double+ROW(2))
+                ICE_OK=ICE_OK .OR. (ROW(5)>1.0e-14_c_double .AND. ROW(10)*RHO_D>NC_FLOOR)
+                SEED_OK=SEED_OK .OR. ROW(8)>0.0_c_double
+              END IF
+              SCORE=SCORE+ROW(5)
+            END DO
+            IF (NUM_OK) NUM_COUNT=NUM_COUNT+1
+            IF (NUM_OK .AND. PAIR_OK) PAIR_COUNT=PAIR_COUNT+1
+            IF (NUM_OK .AND. PAIR_OK .AND. ICE_OK) ICE_COUNT=ICE_COUNT+1
+            IF (NUM_OK .AND. PAIR_OK .AND. ICE_OK .AND. SEED_OK) THEN
+              SEED_COUNT=SEED_COUNT+1
+              ELIG_COUNT=ELIG_COUNT+1
+              ! Row-major traversal retains the first (j,i) on equal score.
+              IF (SCORE>BEST_SCORE) THEN
+                BEST_SCORE=SCORE; BI=CI; BJ=CJ; BEST_LAND=LAND
+              END IF
+            END IF
+          END DO
+        END DO
+        WRITE(CENSUS_FILE,'(A,"/step_",I4.4,"_i_",I4.4,"_j_",I4.4,".tsv")') &
+          TRIM(CENSUS_DIR), ITIMESTEP, ITS, JTS
+        OPEN(NEWUNIT=U,FILE=TRIM(CENSUS_FILE),STATUS='NEW',ACTION='WRITE',IOSTAT=IOS)
+        IF (IOS/=0) CALL wrf_error_fatal('cannot create unique input census file')
+        WRITE(U,'(A)') 'KDM6_INPUT_CENSUS_V1'
+        WRITE(U,'(A)') 'selectors physics_variant=2 dry_number=1'
+        WRITE(U,'(A,7(1X,I0))') 'tile',ITIMESTEP,ITS,ITE,JTS,JTE,KTS,KTE
+        WRITE(U,'(A,6(1X,I0))') 'counts',IM*JM,NUM_COUNT,PAIR_COUNT,ICE_COUNT,SEED_COUNT,ELIG_COUNT
+        WRITE(U,'(A,3(1X,ES26.17E3))') 'settings',REAL(DELT,c_double), &
+          REAL(ncmin_land,c_double),REAL(ncmin_sea,c_double)
+        IF (ELIG_COUNT>0) THEN
+          WRITE(U,'(A,2(1X,I0),2(1X,ES26.17E3))') 'best',ITS+BI-1,JTS+BJ-1,BEST_SCORE,BEST_LAND
+          DO CK=1,KM
+            BEST_STATE(:,CK)=[REAL(TH_IN(BI,CK,BJ),c_double),REAL(Q_IN(BI,CK,BJ),c_double), &
+                 REAL(QC_IN(BI,CK,BJ),c_double),REAL(QR_IN(BI,CK,BJ),c_double), &
+                 REAL(QI_IN(BI,CK,BJ),c_double),REAL(QS_IN(BI,CK,BJ),c_double), &
+                 REAL(QG_IN(BI,CK,BJ),c_double),REAL(NN_IN(BI,CK,BJ),c_double), &
+                 REAL(NC_IN(BI,CK,BJ),c_double),REAL(NI_IN(BI,CK,BJ),c_double), &
+                 REAL(NR_IN(BI,CK,BJ),c_double),REAL(BG_IN(BI,CK,BJ),c_double)]
+            BEST_FORCE(:,CK)=[REAL(DEN_IN(BI,CK,BJ),c_double),REAL(PII_IN(BI,CK,BJ),c_double), &
+                 REAL(P_IN(BI,CK,BJ),c_double),REAL(DELZ_IN(BI,CK,BJ),c_double)]
+          END DO
+          DO CF=1,12
+            DO CK=1,KM
+              WRITE(U,'(A,2(1X,I0),1X,ES26.17E3)') 'STATE_IN',CF,CK,BEST_STATE(CF,CK)
+            END DO
+          END DO
+          DO CF=1,4
+            DO CK=1,KM
+              WRITE(U,'(A,2(1X,I0),1X,ES26.17E3)') 'FORCING',CF,CK,BEST_FORCE(CF,CK)
+            END DO
+          END DO
+        END IF
+        CLOSE(U,IOSTAT=IOS)
+        IF (IOS/=0) CALL wrf_error_fatal('cannot close input census file')
+        WRITE(*,'(A,7(1X,I0))') 'KDM6_INPUT_CENSUS_TILE',ITIMESTEP,ITS,ITE,JTS,JTE,ELIG_COUNT,IM*JM
+      END IF
+    END BLOCK
+
     ! One-column fp64 derivative probe on the same normalized/dry-number state
     ! staged for the value-only host forecast immediately below.
     BLOCK
