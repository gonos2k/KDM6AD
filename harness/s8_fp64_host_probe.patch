+      ENABLED = ''
+      CALL GET_ENVIRONMENT_VARIABLE('KDM6_S8_FP64_PROBE', ENABLED, &
+                                    LENGTH=ENV_LENGTH, STATUS=ENV_STATUS)
+      PROBE_ENABLED = .FALSE.
+      IF (ENV_STATUS == 0 .AND. ENV_LENGTH == 1) PROBE_ENABLED = ENABLED(1:1) == '1'
+      TARGET_IN_TILE = ITS <= 200 .AND. 200 <= ITE .AND. JTS <= 152 .AND. 152 <= JTE
+      IF (PROBE_ENABLED .AND. .NOT. S8_FP64_PROBE_DONE .AND. &
+          IM == 232 .AND. KM == 39 .AND. JM == 139 .AND. TARGET_IN_TILE) THEN
+        ISEL = 200 - ITS + 1
+        JSEL = 152 - JTS + 1
+        ALLOCATE(STATE64(1,KM,1,12), FORCE64(1,KM,1,4), OUT64(1,KM,1,12))
+        ALLOCATE(V(12*KM), JV(12*KM), JTU(12*KM))
+        STATE64(1,:,1,1)=REAL(TH_IN(ISEL,:,JSEL),c_double)
+        STATE64(1,:,1,2)=REAL(Q_IN(ISEL,:,JSEL),c_double)
+        STATE64(1,:,1,3)=REAL(QC_IN(ISEL,:,JSEL),c_double)
+        STATE64(1,:,1,4)=REAL(QR_IN(ISEL,:,JSEL),c_double)
+        STATE64(1,:,1,5)=REAL(QI_IN(ISEL,:,JSEL),c_double)
+        STATE64(1,:,1,6)=REAL(QS_IN(ISEL,:,JSEL),c_double)
+        STATE64(1,:,1,7)=REAL(QG_IN(ISEL,:,JSEL),c_double)
+        STATE64(1,:,1,8)=REAL(NN_IN(ISEL,:,JSEL),c_double)
+        STATE64(1,:,1,9)=REAL(NC_IN(ISEL,:,JSEL),c_double)
+        STATE64(1,:,1,10)=REAL(NI_IN(ISEL,:,JSEL),c_double)
+        STATE64(1,:,1,11)=REAL(NR_IN(ISEL,:,JSEL),c_double)
+        STATE64(1,:,1,12)=REAL(BG_IN(ISEL,:,JSEL),c_double)
+        FORCE64(1,:,1,1)=REAL(DEN_IN(ISEL,:,JSEL),c_double)
+        FORCE64(1,:,1,2)=REAL(PII_IN(ISEL,:,JSEL),c_double)
+        FORCE64(1,:,1,3)=REAL(P_IN(ISEL,:,JSEL),c_double)
+        FORCE64(1,:,1,4)=REAL(DELZ_IN(ISEL,:,JSEL),c_double)
+        XLAND_ONE(1,1)=XLAND_IN(ISEL,JSEL)
+        AD_HANDLE = C_NULL_PTR
+        AD_RC = kdm6_step_ad_variant(STATE64, FORCE64, 1_c_int, INT(KM,c_int), 1_c_int, &
+             REAL(DELT,c_double), 0_c_int, OUT64, AD_HANDLE, XLAND_ONE, &
+             REAL(ncmin_land,c_double), REAL(ncmin_sea,c_double), &
+             KDM6_PHYSICS_CONSERVATIVE_INTERFACE)
+        IF (AD_RC == KDM6_OK) THEN
+          IF (ANY(.NOT. ieee_is_finite(OUT64))) THEN
+            AD_RC = KDM6_ERR_INTERNAL
+          ELSE
+            NORM_OUT = NORM2(OUT64)
+            IF (ieee_is_finite(NORM_OUT)) THEN
+              IF (NORM_OUT <= 0.0_c_double) AD_RC = KDM6_ERR_INTERNAL
+            ELSE
+              AD_RC = KDM6_ERR_INTERNAL
+            END IF
+          END IF
+        END IF
+        IF (AD_RC /= KDM6_OK .OR. .NOT. C_ASSOCIATED(AD_HANDLE)) THEN
+          IF (C_ASSOCIATED(AD_HANDLE)) CLOSE_RC = kdm6_handle_close(AD_HANDLE)
+          CALL wrf_error_fatal('S8HAD: fp64 conservative forward failed')
+        END IF
+        V = 0.0_c_double
+        V(4*KM+1:5*KM) = STATE64(1,:,1,5)
+        NORM_V = NORM2(V)
+        IF (ieee_is_finite(NORM_V)) THEN
+          IF (NORM_V <= 0.0_c_double) AD_RC = KDM6_ERR_INTERNAL
+        ELSE
+          AD_RC = KDM6_ERR_INTERNAL
+        END IF
+        IF (AD_RC == KDM6_OK) AD_RC = kdm6_handle_jvp(AD_HANDLE, V, JV)
+        IF (AD_RC == KDM6_OK) THEN
+          IF (ANY(.NOT. ieee_is_finite(JV))) AD_RC = KDM6_ERR_INTERNAL
+        END IF
+        IF (AD_RC == KDM6_OK) THEN
+          AD_RC = kdm6_handle_vjp(AD_HANDLE, JV, JTU)
+          IF (AD_RC == KDM6_OK) THEN
+            IF (ANY(.NOT. ieee_is_finite(JTU))) AD_RC = KDM6_ERR_INTERNAL
+          END IF
+        END IF
+        CLOSE_RC = kdm6_handle_close(AD_HANDLE)
+        IF (CLOSE_RC /= KDM6_OK .OR. C_ASSOCIATED(AD_HANDLE)) THEN
+          CALL wrf_error_fatal('S8HAD: handle close failed')
+        END IF
+        IF (AD_RC /= KDM6_OK) CALL wrf_error_fatal('S8HAD: JVP/VJP failed')
+        NORM_JV = NORM2(JV)
+        NORM_JTU = NORM2(JTU)
+        LEFT_DOT = SUM(JV*JV)
+        RIGHT_DOT = SUM(V*JTU)
+        IF (.NOT. ieee_is_finite(NORM_JV)) CALL wrf_error_fatal('S8HAD: nonfinite JVP norm')
+        IF (NORM_JV <= 0.0_c_double) CALL wrf_error_fatal('S8HAD: zero JVP norm')
+        IF (.NOT. ieee_is_finite(NORM_JTU)) CALL wrf_error_fatal('S8HAD: nonfinite VJP norm')
+        IF (NORM_JTU <= 0.0_c_double) CALL wrf_error_fatal('S8HAD: zero VJP norm')
+        IF (.NOT. ieee_is_finite(LEFT_DOT)) CALL wrf_error_fatal('S8HAD: nonfinite left dot')
+        IF (LEFT_DOT == 0.0_c_double) CALL wrf_error_fatal('S8HAD: zero left dot')
+        IF (.NOT. ieee_is_finite(RIGHT_DOT)) CALL wrf_error_fatal('S8HAD: nonfinite right dot')
+        IF (RIGHT_DOT == 0.0_c_double) CALL wrf_error_fatal('S8HAD: zero right dot')
+        REL_DUAL = ABS(LEFT_DOT-RIGHT_DOT)/MAX(ABS(LEFT_DOT),ABS(RIGHT_DOT),TINY(LEFT_DOT))
+        IF (.NOT. ieee_is_finite(REL_DUAL)) CALL wrf_error_fatal('S8HAD: nonfinite duality')
+        IF (REL_DUAL > 1.0e-10_c_double) CALL wrf_error_fatal('S8HAD: duality failed')
+        WRITE(*,*) 'S8HAD_v1', 'physics_variant=1', 'value_only=0', KDM6_ABI_VERSION, &
+                   'ad_dims', 1, KM, 1, 'tile_dims', IM, KM, JM, &
+                   'global_cell', 200, 152, 'tile_local', ISEL, JSEL, &
+                   NORM_OUT, NORM_V, NORM_JV, NORM_JTU, LEFT_DOT, RIGHT_DOT, REL_DUAL
+        S8_FP64_PROBE_DONE = .TRUE.
+      END IF
+    END BLOCK
